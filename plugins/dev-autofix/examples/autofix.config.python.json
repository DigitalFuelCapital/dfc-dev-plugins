{
  "$schema": "https://raw.githubusercontent.com/DigitalFuelCapital/dfc-dev-plugins/main/plugins/dev-autofix/schema/autofix.config.schema.json",
  "version": 1,
  "maxDiffLines": 120,
  "protectedPaths": [
    "^alembic/versions/"
  ],
  "deployPatterns": [],
  "forbidden": [
    "Never create or edit Alembic migrations.",
    "Never add a dependency; name it in the report instead."
  ],
  "repos": [
    {
      "name": "my-service",
      "path": "/Users/you/code/my-service",
      "remote": "your-org/my-service",
      "baseBranch": "develop",
      "install": "uv sync --frozen",
      "lockfile": "uv.lock",
      "installMarker": ".venv",
      "verify": [
        "uv run ruff check .",
        "uv run mypy src",
        "uv run pytest -q -x"
      ],
      "testCommand": "uv run pytest -q {files}",
      "env": [
        "UV_INDEX_URL"
      ],
      "forbidden": [
        "Do not edit files under src/generated/; they come from `make codegen`."
      ]
    }
  ]
}
