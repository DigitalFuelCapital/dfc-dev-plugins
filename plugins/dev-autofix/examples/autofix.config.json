{
  "version": 1,

  "reservePercent": 10,
  "fiveHourCeiling": 90,
  "maxFixesPerRun": 5,
  "perFixPercentEstimate": 3,
  "workerModel": "sonnet",
  "maxDiffLines": 150,

  "queuePath": "AUTOFIX_QUEUE.md",
  "coAuthor": "Claude <noreply@anthropic.com>",

  "forbidden": [
    "Never write or run SQL, and never edit files under sql/ or .supabase/.",
    "Never deploy; `wrangler deploy --dry-run` is allowed for verification only."
  ],

  "repos": [
    {
      "name": "dfc-tools",
      "path": "/Users/you/Documents/GitHub/DigitalFuelCapital/DFC/dfc-tools",
      "remote": "DigitalFuelCapital/dfc-tools",
      "baseBranch": "staging",
      "verify": ["npm run lint", "npm run format:check", "npm run test"],
      "testCommand": "npx vitest run {files}",
      "forbidden": [
        "Do not write tests unless the queue entry explicitly asks for one.",
        "Ignore TODO: comments, commented-out code and TODO.md.",
        "Never edit types/supabase.ts; it is generated by npm run db:types."
      ]
    },
    {
      "name": "dfc-cro",
      "path": "/Users/you/Documents/GitHub/DigitalFuelCapital/DFC/dfc-cro",
      "remote": "DigitalFuelCapital/dfc-cro",
      "baseBranch": "staging",
      "verify": ["npm run lint", "npm run typecheck", "npm run typecheck:functions", "npm run test"]
    }
  ]
}
